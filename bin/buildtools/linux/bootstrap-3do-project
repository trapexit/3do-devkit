#!/usr/bin/env sh

case $# in
    0)
        DST_PATH="$(pwd)"
        ;;
    1)
        DST_PATH="${1}"
        ;;
    *)
        echo "usage: bootstrap-project [dstpath]"
        echo "  * dstpath defaults to pwd"
        exit 1
        ;;
esac

if [ -z "${TDO_DEVKIT_PATH}" ]; then
    echo "Error: Source the DevKit environment before bootstrapping (TDO_DEVKIT_PATH is not set)." >&2
    exit 1
fi

if ! command -v armcc >/dev/null 2>&1; then
    echo "Error: Source the DevKit environment before bootstrapping (armcc is not on PATH)." >&2
    exit 1
fi

SRC_PATH="${TDO_DEVKIT_PATH}"

if [ -e "${DST_PATH}/takeme" ] && [ ! -d "${DST_PATH}/takeme" ]; then
    echo "Error: 'takeme' exists and is not a directory. Aborting."
    exit 1
fi

echo "Copying Makefile"
cp "${SRC_PATH}/Makefile" "${DST_PATH}/Makefile" || exit $?

if [ -d "${DST_PATH}/takeme" ]; then
    echo "'takeme' directory exists. Skipping."
else
    echo "Copying takeme (core CDROM filesystem contents)"
    mkdir -p "${DST_PATH}/takeme" || exit $?
    cp "${SRC_PATH}/takeme/AppStartup" "${DST_PATH}/takeme/AppStartup" || exit $?
    cp "${SRC_PATH}/takeme/BannerScreen" "${DST_PATH}/takeme/BannerScreen" || exit $?
    cp -r "${SRC_PATH}/takeme/System" "${DST_PATH}/takeme/System" || exit $?

    if [ -e "${DST_PATH}/data" ]; then
        echo "Copying data/* into takeme/"
        for data_path in "${DST_PATH}/data/"*; do
            [ -e "${data_path}" ] || [ -L "${data_path}" ] || continue
            cp -r "${data_path}" "${DST_PATH}/takeme/" || exit $?
        done
    fi
fi

if [ ! -d "${DST_PATH}/src" ]; then
    echo "Copying starter src/main.c"
    mkdir -p "${DST_PATH}/src" || exit $?
    cp "${SRC_PATH}/src/helloworld/main.c" "${DST_PATH}/src/main.c" || exit $?
fi

echo "Now run 'make' to build the ISO and 'make run' to run in Opera"
